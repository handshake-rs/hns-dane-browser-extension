{
  "manifest_version": 3,
  "name": "HNS DANE Browser",
  "description": "Routes web DNS names through a local Rust dual-root DNSSEC and DANE runtime.",
  "version": "0.6.0",
  "homepage_url": "https://denuoweb.com/work/hns-dane-browser-extension",
  "minimum_chrome_version": "121",
  "incognito": "not_allowed",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging",
    "proxy",
    "scripting",
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "navigation_gate",
        "enabled": true,
        "path": "rules/navigation-gate.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "src/provider-content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/proxy-wait.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "HNS DANE Browser",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_page": "src/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
