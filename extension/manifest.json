{
  "manifest_version": 3,
  "name": "HNS DANE Browser",
  "description": "Routes web DNS names through a local Rust dual-root DNSSEC and DANE runtime.",
  "version": "0.5.0",
  "minimum_chrome_version": "121",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "HNS DANE Browser",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
