{
  "manifest_version": 3,
  "name": "HNS DANE Browser",
  "description": "Routes web DNS names through a local Rust dual-root DNSSEC and DANE runtime.",
  "version": "0.5.4",
  "homepage_url": "https://github.com/handshake-rs/hns-dane-browser-extension",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "nativeMessaging",
    "proxy",
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "HNS DANE Browser",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_page": "src/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
